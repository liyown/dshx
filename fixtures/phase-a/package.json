{
  "name": "@dshx/phase-a-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [],
      "immediately": false
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build-phase-a-client.mjs"
  },
  "devDependencies": {
    "dshx": "workspace:*"
  }
}
