{
  "compilerOptions": {
    "declaration": false,
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "preserveSymlinks": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2024"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
