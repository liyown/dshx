{
  "name": "@becomeopc/dshx-framework-hub",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "pnpm db:migrate:local && vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "cf:preview": "pnpm run build && pnpm run db:migrate:preview && pnpm run db:seed:preview && wrangler dev --config .output/server/wrangler.json --persist-to .wrangler/preview-state --var SITE_URL:http://localhost:8787 --var BETTER_AUTH_SECRET:dshx-local-preview-secret-is-not-for-production --var TURNSTILE_SITE_KEY:1x00000000000000000000AA --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA",
    "cf:typegen": "wrangler types",
    "deploy": "pnpm run build && pnpm run deploy:worker",
    "deploy:check": "pnpm run build && wrangler deploy --dry-run --config .output/server/wrangler.json",
    "deploy:worker": "wrangler deploy --config .output/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dshx-framework-hub --local",
    "db:migrate:preview": "wrangler d1 migrations apply dshx-framework-hub --local --config wrangler.jsonc --persist-to .wrangler/preview-state",
    "db:seed:preview": "wrangler d1 execute dshx-framework-hub --local --config wrangler.jsonc --persist-to .wrangler/preview-state --file seed/dev.sql",
    "db:migrate:remote": "wrangler d1 migrations apply dshx-framework-hub --remote",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "1.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "jose": "6.2.9",
    "lucide-react": "^0.575.0",
    "motion": "^13.1.1",
    "postprocessing": "^6.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "2.17.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.180.0",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.15.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.56.1",
    "vitest": "catalog:",
    "vite": "catalog:",
    "wrangler": "^4.125.0"
  }
}
