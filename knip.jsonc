{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "catalog",
    "catalogReferences",
  ],
  "ignoreBinaries": ["dshx"],
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint"],
  "workspaces": {
    "packages/dshx": {
      "entry": [
        "src/index.ts",
        "src/cli/bin.ts",
        "src/cli/index.ts",
        "src/compiler/host/index.ts",
      ],
      "ignoreDependencies": ["@deepseek-ai/dsh"],
    },
    "fixtures/phase-a": {
      "entry": ["src/host.ts"],
      "ignoreDependencies": ["@deepseek-ai/dsh"],
    },
    "packages/plugin-marketplace": {
      "entry": [
        "dshx.config.ts",
        "src/host.ts",
        "src/client.tsx",
        "vitest.smoke.config.ts",
        "tests/self-bootstrap.smoke.ts",
      ],
    },
    "apps/framework-hub": {
      "entry": ["src/lib/email/previews/*.tsx"],
      "ignore": ["src/test/cloudflare-workers.ts"],
      "ignoreDependencies": ["cloudflare"],
    },
  },
}
