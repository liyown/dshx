{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "catalog",
    "catalogReferences",
  ],
  "ignoreBinaries": ["dsh", "dshx", "wrangler"],
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "publint",
    // scripts/smoke-dsh.mjs invokes the installed playwright-cli binary by
    // path for the local real-DSH browser scenario; nothing imports it.
    "@playwright/cli",
  ],
  "workspaces": {
    "packages/dshx": {
      "entry": [
        "src/index.ts",
        "src/cli/bin.ts",
        "src/cli/index.ts",
        "src/compiler/host/index.ts",
      ],
      // Client-platform peers the compiled plugin bundles resolve at runtime;
      // DSHX source only references their module ids, never imports them.
      "ignoreDependencies": [
        "@deepseek-ai/dsh",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        // dsh-client-store imports these without declaring them; tests and the
        // real Client module table expect them in the workspace.
        "immer",
        "zustand",
      ],
    },
    "fixtures/phase-a": {
      "entry": ["src/host.ts"],
      // JSX uses the automatic runtime, so neither package appears in an import.
      "ignoreDependencies": ["@deepseek-ai/dsh", "react", "@types/react"],
    },
    "packages/hub-contracts": {
      "entry": ["src/index.ts"],
    },
    "packages/plugin-marketplace": {
      "entry": [
        "dshx.config.ts",
        "src/host.ts",
        "src/client.tsx",
        "vitest.smoke.config.ts",
        "tests/self-bootstrap.smoke.ts",
      ],
    },
    "apps/framework-hub": {
      "entry": ["src/lib/email/previews/*.tsx"],
      "ignore": ["src/test/cloudflare-workers.ts"],
      "ignoreDependencies": ["cloudflare"],
    },
  },
}
