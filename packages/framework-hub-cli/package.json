{
  "name": "@becomeopc/dshx-hub-cli",
  "version": "0.1.2-preview.5",
  "description": "Atomic Hub operations, public source inspection, and durable local operations runs.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "plugins",
    "operations",
    "catalog",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liyown/dshx.git",
    "directory": "packages/framework-hub-cli"
  },
  "bugs": {
    "url": "https://github.com/liyown/dshx/issues"
  },
  "homepage": "https://dshx.io",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "dshx-hub": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --dir ../hub-ops-prompt build && tsc -p tsconfig.build.json && node scripts/bundle-ops-prompt.mjs",
    "prepack": "pnpm build",
    "lint": "prettier --check src test",
    "smoke:package": "node scripts/smoke-ops-package.mjs",
    "test:keyring-load": "node test/keyring-load.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "open": "11.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
