{
  "name": "@becomeopc/dshx",
  "version": "0.1.1",
  "description": "Build and debug DeepSeek Harness Host and Client plugins.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "plugins",
    "typescript",
    "vite",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liyown/dshx.git",
    "directory": "packages/dshx"
  },
  "bugs": {
    "url": "https://github.com/liyown/dshx/issues"
  },
  "homepage": "https://dshx.io/docs",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dshx": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "default": "./dist/compat/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "default": "./dist/conversation/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "citty": "0.2.2",
    "diff": "9.0.0",
    "execa": "catalog:",
    "lightningcss": "1.33.0",
    "semver": "7.8.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "write-file-atomic": "7.0.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-cordis-host-runner": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tool-cordis": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/react": "~18.3.31",
    "@types/semver": "^7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-cordis-host-runner": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tool-cordis": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-cordis-host-runner": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-cordis": {
      "optional": true
    }
  }
}
